    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum by (site) (label_replace(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/.*\", envoy_response_code_class=\"5\"}[$__rate_interval]), \"site\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\"))",
     "refId": "A",
     "legendFormat": "{{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
