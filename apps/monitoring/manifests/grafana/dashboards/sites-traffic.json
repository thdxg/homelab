      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Requests by listener",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_http_downstream_rq_completed{envoy_http_conn_manager_prefix=\"https-10443\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "HTTPS"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_http_downstream_rq_completed{envoy_http_conn_manager_prefix=\"http-10080\"}[$__rate_interval]))",
     "refId": "B",
     "legendFormat": "HTTP"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "min": 0
