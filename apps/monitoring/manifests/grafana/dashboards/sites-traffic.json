     "expr": "histogram_quantile(0.95, sum by (le, site) (label_replace(rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval]), \"site\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\")))",
     "refId": "A",
     "legendFormat": "{{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Upstream request time, 95th percentile per site."
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "5xx / s by site",
   "gridPos": {
    "x": 12,
    "y": 12,
