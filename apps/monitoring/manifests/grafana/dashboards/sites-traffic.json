{
 "uid": "homelab-sites-traffic",
 "title": "Sites / Traffic",
 "tags": [
  "homelab",
  "envoy"
 ],
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "timepicker": {},
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests / s",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "All sites, from Envoy's per-route upstream counters."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Active connections",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(envoy_http_downstream_cx_active{envoy_http_conn_manager_prefix=~\"http-10080|https-10443\"})",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "Open client connections on the public HTTP and HTTPS listeners."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "5xx ratio",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/.*\", envoy_response_code_class=\"5\"}[$__rate_interval])) / sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "Share of responses that were 5xx. Empty when there is no traffic."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p95 latency",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 500
       },
       {
        "color": "red",
        "value": 2000
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "Upstream request time as seen by Envoy, all sites."
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests / s by site",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum by (site) (label_replace(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval]), \"site\", \"$1\", \"envoy_cluster_name\", \"httproute/[^/]+/([^/]+)/rule/.*\"))",
     "refId": "A",
     "legendFormat": "{{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Responses by status class",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum by (envoy_response_code_class) (rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "{{envoy_response_code_class}}xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "2xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "3xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "4xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "5xx"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
