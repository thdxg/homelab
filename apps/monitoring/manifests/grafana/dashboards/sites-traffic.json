     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Cloudflare talks to the origin over HTTPS; plain HTTP is mostly redirects and scanners."
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Requests by protocol",
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_http_downstream_rq_http1_total{envoy_http_conn_manager_prefix=~\"http-10080|https-10443\"}[$__rate_interval]))",
     "refId": "A",
     "legendFormat": "HTTP/1.1"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_http_downstream_rq_http2_total{envoy_http_conn_manager_prefix=~\"http-10080|https-10443\"}[$__rate_interval]))",
     "refId": "B",
     "legendFormat": "HTTP/2"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(rate(envoy_http_downstream_rq_http3_total{envoy_http_conn_manager_prefix=~\"http-10080|https-10443\"}[$__rate_interval]))",
     "refId": "C",
     "legendFormat": "HTTP/3"
