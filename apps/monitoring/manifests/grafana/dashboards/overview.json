{
 "uid": "homelab-overview",
 "title": "Homelab / Overview",
 "tags": [
  "homelab"
 ],
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "timepicker": {},
 "annotations": {
  "list": []
 },
 "templating": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "id": 12,
   "type": "stat",
   "title": "Nodes ready",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "mimir"
     },
     "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
